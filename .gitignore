# Gradle writes here too; /build/ above only covers the project root.
/android/build/
/android/.gradle/
/android/.kotlin/

# Local run artefacts
crash_log.txt
flutter_jank_metrics_*.json

# Per-developer tool permissions; the shared .claude/settings.json is tracked.
.claude/settings.local.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# License signing keys - never commit, these sign every generated license
*.pem
license_out.txt
reset_token_out.txt

# Python OCR server virtualenv
ocr_server/.venv/
ocr_server/venv/
